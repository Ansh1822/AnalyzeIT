# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# local = subprocess on your machine (easiest on Windows)
# docker = isolated container, no network (build the image first, see README)
SANDBOX=local
# Production: your frontend URL (comma-separated if several), no trailing slash
FRONTEND_ORIGIN=
RUNS_PER_HOUR=10
# Set to false on a public deployment
ENABLE_DB=true
